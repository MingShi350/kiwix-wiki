{
  "name": "@local/kiwix-wiki",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Offline Wikipedia database query tools backed by the local Kiwix ZIM library",
  "license": "MIT",
  "author": "MingShi350",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MingShi350/kiwix-wiki.git"
  },
  "homepage": "https://github.com/MingShi350/kiwix-wiki#readme",
  "bugs": {
    "url": "https://github.com/MingShi350/kiwix-wiki/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "kiwix",
    "zim",
    "wikipedia",
    "offline",
    "opds"
  ],
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./lib/kiwix.js": "./lib/kiwix.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2 || ^4.0.5-0"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/*.md",
    "examples/*",
    "test/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
