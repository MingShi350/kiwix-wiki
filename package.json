{
  "name": "@local/kiwix-wiki",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Offline Wikipedia database query tools backed by the local Kiwix ZIM library",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "kiwix",
    "zim",
    "wikipedia",
    "offline",
    "opds"
  ],
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./lib/kiwix.js": "./lib/kiwix.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/*.md",
    "examples/*",
    "test/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
